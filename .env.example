# ─────────────────────────────────────────────────────────────────────────────
# .env.example — copy to .env for local development
# NEVER commit a .env file with real secrets to version control.
# In production (Azure Container Apps), set these as secret env vars via the portal.
# ─────────────────────────────────────────────────────────────────────────────

# ── Azure Blob Storage ────────────────────────────────────────────────────────
# Required. Use the Blob service endpoint from Azure Portal → Storage account → Endpoints.
# Local authentication uses DefaultAzureCredential; run `az login` before starting the API.
AZURE_STORAGE_ACCOUNT_URL=https://<your-account>.blob.core.windows.net
AZURE_STORAGE_CONTAINER=signatures

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=text    # text for local dev, json for production

# ── Model ─────────────────────────────────────────────────────────────────────
MODEL_PATH=app/ml/exported_model/siamese_signature_model.pt
INFERENCE_THRESHOLD=0.5208    # GENUINE iff d < threshold (was 0.6851, the validation 4:1 EER point)
# Borderline zone lower edge (validation 4:1 FAR 10% point). REVIEW_LOWER <= d < INFERENCE_THRESHOLD
# is reported as "borderline, examiner review recommended"; the verdict stays GENUINE.
# Inactive while it is >= INFERENCE_THRESHOLD. With 0.5208 the zone is 0.4835 <= d < 0.5208.
REVIEW_LOWER_THRESHOLD=0.4835

# ── Security (optional) ────────────────────────────────────────────────────────
# Uncomment and set to enable shared-secret header validation.
# The .NET API must send this value in the X-Internal-Api-Key header.
# INTERNAL_API_KEY=replace-with-a-long-random-secret

# ── CORS ──────────────────────────────────────────────────────────────────────
# In production, restrict to the .NET API's hostname.
CORS_ORIGINS=["*"]
