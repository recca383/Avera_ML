# ─────────────────────────────────────────────────────────────────────────────
# .env.example — copy to .env for local development
# NEVER commit a .env file with real secrets to version control.
# In production (Azure Container Apps), set these as secret env vars via the portal.
# ─────────────────────────────────────────────────────────────────────────────

# ── Azure Blob Storage ────────────────────────────────────────────────────────
# Required. Get from Azure Portal → Storage Account → Access Keys.
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<your-account>;AccountKey=<your-key>;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER=signatures

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=text    # text for local dev, json for production

# ── Model ─────────────────────────────────────────────────────────────────────
MODEL_PATH=app/ml/exported_model/siamese_signature_model.pt
INFERENCE_THRESHOLD=0.485123

# ── Security (optional) ────────────────────────────────────────────────────────
# Uncomment and set to enable shared-secret header validation.
# The .NET API must send this value in the X-Internal-Api-Key header.
# INTERNAL_API_KEY=replace-with-a-long-random-secret

# ── CORS ──────────────────────────────────────────────────────────────────────
# In production, restrict to the .NET API's hostname.
CORS_ORIGINS=["*"]
